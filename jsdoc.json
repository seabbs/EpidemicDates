{
  "source": {
    "include": [
      "onset-imputation.js"
    ]
  },
  "plugins": [
    "plugins/markdown"
  ],
  "markdown": {
    "idInHeadings": true
  },
  "opts": {
    "encoding": "utf8",
    "recurse": false,
    "readme": "docs/js-index.md"
  },
  "templates": {
    "cleverLinks": true,
    "default": {
      "includeDate": false
    }
  }
}
